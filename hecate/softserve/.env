SOFT_SERVE_NAME=SoftServe

# Public key only -- never a private key. Grants admin (full) access via
# SSH to whoever holds the matching private key. Add more keys
# space/newline-separated to grant additional admins.
SOFT_SERVE_INITIAL_ADMIN_KEYS=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIM2BduQr8R0BjHEZYPATLhkbYKb/LZZdrTQJ9+mzyRsh turner@delphi

# No SSH key registered on the server at all -> no access, not even a
# clone. Every repo interaction (including read) requires a registered
# key, added via the admin TUI over SSH once the service is up.
SOFT_SERVE_ANON_ACCESS=no-access

SOFT_SERVE_HTTP_PUBLIC_URL=http://10.0.20.10:23232
